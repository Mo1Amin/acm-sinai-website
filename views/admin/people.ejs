<%- include('partials/top') %>
<p class="text-ink-muted mb-5">Change the board here when the new team takes over. Founders show under "High Board" on the site.</p>
<div class="flex flex-col gap-6">
    <% Object.entries(groups).forEach(([grp, label]) => { const rows = people.filter((p) => p.grp === grp); %>
        <section class="admin-card">
            <div class="flex items-center gap-3 mb-3">
                <h2 class="font-bold text-ink"><%= label %></h2>
                <span class="text-sm text-ink-muted"><%= rows.length %></span>
                <a href="/admin/people/new?grp=<%= grp %>" class="admin-btn-ghost !py-2 ml-auto"><i class="fas fa-plus"></i> Add</a>
            </div>
            <% if (!rows.length) { %><p class="text-ink-muted text-sm py-3">Nobody here yet.</p><% } %>
            <div class="flex flex-col">
                <% rows.forEach((p, i) => { const action = `/admin/people/${p.id}/action`; %>
                    <div class="flex items-center gap-3 py-2.5 border-b last:border-0" style="border-color: rgb(var(--line) / .06)">
                        <% if (p.photo) { %><img src="<%= asset(p.photo) %>" alt="" class="w-11 h-11 rounded-full object-cover shrink-0"><% } else { %><div class="w-11 h-11 rounded-full grid place-items-center avatar-initials text-sm font-black shrink-0"><%= initials(p.name) %></div><% } %>
                        <div class="min-w-0 flex-1"><div class="font-semibold text-ink truncate"><%= p.name %></div><div class="text-sm text-ink-muted truncate"><%= p.role %></div></div>
                        <% if (!p.is_visible) { %><span class="admin-pill bg-slate-500/10 text-slate-500"><i class="fas fa-eye-slash"></i> Hidden</span><% } %>
                        <form method="post" action="<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button name="action" value="up" class="w-9 h-9 rounded-lg hover:bg-surface-2 disabled:opacity-30" <%= i === 0 ? 'disabled' : '' %> aria-label="Move up"><i class="fas fa-arrow-up"></i></button></form>
                        <form method="post" action="<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button name="action" value="down" class="w-9 h-9 rounded-lg hover:bg-surface-2 disabled:opacity-30" <%= i === rows.length - 1 ? 'disabled' : '' %> aria-label="Move down"><i class="fas fa-arrow-down"></i></button></form>
                        <form method="post" action="<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button name="action" value="toggle" class="w-9 h-9 rounded-lg hover:bg-surface-2" aria-label="<%= p.is_visible ? 'Hide' : 'Show' %>"><i class="fas <%= p.is_visible ? 'fa-eye-slash' : 'fa-eye' %>"></i></button></form>
                        <a href="/admin/people/<%= p.id %>" class="w-9 h-9 grid place-items-center rounded-lg hover:bg-surface-2" aria-label="Edit"><i class="fas fa-pen"></i></a>
                        <form method="post" action="<%= action %>" data-confirm="Remove <%= p.name %> from the team?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button name="action" value="delete" class="w-9 h-9 rounded-lg hover:bg-rose-500/10 text-rose-600" aria-label="Remove"><i class="fas fa-trash"></i></button></form>
                    </div>
                <% }) %>
            </div>
        </section>
    <% }) %>
</div>
<%- include('partials/bottom') %>
