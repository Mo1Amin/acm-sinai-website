<%- include('partials/top') %>
<%
  const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  let maxHeat = 1; let peak = [0, 0, 0];
  stats.heat.forEach((row, wd) => row.forEach((n, h) => { maxHeat = Math.max(maxHeat, n); if (n > peak[2]) peak = [wd, h, n]; }));
  const pad = (n) => String(n).padStart(2, '0');
  const prettyClick = (t) => {
    t = String(t || '');
    if (t.startsWith('track:')) return 'Opened track: ' + t.slice(6);
    if (t.startsWith('track-join:')) return 'Joined track: ' + t.slice(11);
    if (t.startsWith('album:')) return 'Opened album: ' + t.slice(6);
    if (t.startsWith('event-register:')) return 'Event registration #' + t.slice(15);
    return ({ 'join-register': 'Membership registration', 'join-whatsapp': 'WhatsApp updates', 'hero-join': 'Hero · Join Chapter', 'hero-tracks': 'Hero · Explore Tracks' })[t] || t;
  };
  const barList = (rows, empty, label) => {
    if (!rows.length) return `<p class="text-ink-muted text-sm py-4">${esc(empty)}</p>`;
    const max = Math.max(...rows.map((r) => r.n), 1);
    return '<ul class="flex flex-col gap-2">' + rows.map((r) => {
      const w = Math.max(4, Math.round((r.n / max) * 100));
      return `<li class="relative rounded-lg overflow-hidden"><div class="absolute inset-y-0 left-0 bg-brand/10" style="width:${w}%"></div><div class="relative flex justify-between gap-3 px-3 py-2 text-sm"><span class="text-ink truncate">${esc(label ? label(r.label) : r.label)}</span><span class="font-bold text-ink">${r.n.toLocaleString()}</span></div></li>`;
    }).join('') + '</ul>';
  };
%>
<div class="flex flex-wrap items-center gap-2 mb-6">
    <% [[7, '7 days'], [30, '30 days'], [90, '90 days'], [365, '12 months']].forEach(([d, label]) => { %>
        <a href="/admin/analytics?days=<%= d %>" class="<%= days === d ? 'admin-btn' : 'admin-btn-ghost' %>"><%= label %></a>
    <% }) %>
    <span class="ml-auto text-xs text-ink-muted"><i class="fas fa-user-shield"></i> Cookieless: no personal data or IP addresses are stored.</span>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="admin-card"><div class="text-sm text-ink-muted font-semibold">Unique visitors</div><div class="mt-2 text-3xl font-black text-ink"><%= stats.visitors.toLocaleString() %></div></div>
    <div class="admin-card"><div class="text-sm text-ink-muted font-semibold">Page views</div><div class="mt-2 text-3xl font-black text-ink"><%= stats.views.toLocaleString() %></div></div>
    <div class="admin-card"><div class="text-sm text-ink-muted font-semibold">Clicks</div><div class="mt-2 text-3xl font-black text-ink"><%= stats.clicks.toLocaleString() %></div></div>
    <div class="admin-card"><div class="text-sm text-ink-muted font-semibold">Busiest time</div><div class="mt-2 text-2xl font-black text-ink"><%= peak[2] ? `${weekdays[peak[0]]} · ${pad(peak[1])}:00` : '—' %></div></div>
</div>

<div class="admin-card mt-4">
    <h2 class="font-bold text-ink mb-3">Visitors and page views</h2>
    <div class="h-64"><canvas id="chart-daily" data-series="<%= JSON.stringify(stats.series) %>"></canvas></div>
</div>

<div class="admin-card mt-4 overflow-x-auto">
    <h2 class="font-bold text-ink">When people visit</h2>
    <p class="text-sm text-ink-muted mb-4">Page views by day and hour (Cairo time). Darker means busier. Use it to pick posting times.</p>
    <div class="min-w-[640px]">
        <div class="grid gap-1" style="grid-template-columns: 44px repeat(24, minmax(0,1fr))">
            <div></div>
            <% for (let h = 0; h < 24; h++) { %><div class="text-[10px] text-center text-ink-muted"><%= h % 3 === 0 ? h : '' %></div><% } %>
            <% stats.heat.forEach((row, wd) => { %>
                <div class="text-xs text-ink-muted self-center"><%= weekdays[wd] %></div>
                <% row.forEach((n, h) => { const a = n ? 0.12 + 0.88 * (n / maxHeat) : 0.04; %>
                    <div class="heat-cell" title="<%= weekdays[wd] %> <%= pad(h) %>:00 · <%= n %> views" style="background: rgb(var(--brand) / <%= a.toFixed(2) %>)"></div>
                <% }) %>
            <% }) %>
        </div>
    </div>
</div>

<div class="grid lg:grid-cols-2 gap-4 mt-4">
    <div class="admin-card"><h2 class="font-bold text-ink mb-3">Sections people reached</h2><%- barList(stats.sections, 'No data yet.', (l) => String(l || '').replace('track:', 'Track page: ').replace(/^\w/, (c) => c.toUpperCase())) %></div>
    <div class="admin-card"><h2 class="font-bold text-ink mb-3">Top clicks</h2><%- barList(stats.clicksTop, 'No clicks yet.', prettyClick) %></div>
    <div class="admin-card"><h2 class="font-bold text-ink mb-3">Where visitors come from</h2><%- barList(stats.referrers, 'No data yet.') %></div>
    <div class="admin-card"><h2 class="font-bold text-ink mb-3">Devices</h2><%- barList(stats.devices, 'No data yet.', (l) => String(l).replace(/^\w/, (c) => c.toUpperCase())) %></div>
    <div class="admin-card lg:col-span-2"><h2 class="font-bold text-ink mb-3">Top pages</h2><%- barList(stats.pages, 'No data yet.') %></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
<%- include('partials/bottom') %>
