<%
  const fs = settings || {};
  const socials = [['facebook_url', 'fa-facebook-f', 'Facebook'], ['instagram_url', 'fa-instagram', 'Instagram'], ['tiktok_url', 'fa-tiktok', 'TikTok'], ['linkedin_url', 'fa-linkedin-in', 'LinkedIn']];
  const onHome = typeof isHome !== 'undefined' && isHome;
  const links = [['about', 'About'], ['tracks', 'Tracks'], ['events', 'Events'], ['gallery', 'Gallery'], ['team', 'Team'], ['join', 'Join']];
%>
<footer class="site-footer mt-10 pt-16 md:pt-20 pb-8 relative overflow-hidden">
    <div class="footer-glow" aria-hidden="true"></div>
    <div class="container mx-auto px-6 relative">
        <div class="grid grid-cols-2 md:grid-cols-12 gap-x-6 gap-y-10">
            <div class="col-span-2 md:col-span-5">
                <a href="/" class="inline-flex items-center gap-3">
                    <img src="/assets/img/logo.webp" alt="" width="48" height="48" class="w-12 h-12 object-contain" loading="lazy">
                    <span class="leading-none">
                        <span class="block font-extrabold text-xl text-white tracking-tight">ACM <span class="text-cyan-300">Sinai</span></span>
                        <span class="block font-tech text-[10px] uppercase tracking-[0.2em] text-slate-400 mt-1.5">Sinai University Student Chapter</span>
                    </span>
                </a>
                <p class="text-slate-400 mt-5 max-w-sm leading-relaxed">Empowering students to create, innovate, and inspire.</p>
                <div class="flex gap-2 mt-6">
                    <% socials.forEach(([key, icon, label]) => { if (fs[key]) { %>
                        <a href="<%= fs[key] %>" target="_blank" rel="noopener" aria-label="<%= label %>" class="footer-social"><i class="fab <%= icon %>"></i></a>
                    <% } }) %>
                </div>
            </div>
            <div class="md:col-span-3">
                <h3 class="footer-head">Explore</h3>
                <ul class="grid gap-2.5">
                    <% links.forEach(([id, label]) => { %>
                        <li><a href="<%= onHome ? '#' + id : '/#' + id %>" class="footer-link"><%= label %></a></li>
                    <% }) %>
                </ul>
            </div>
            <div class="md:col-span-4">
                <h3 class="footer-head">Get in touch</h3>
                <ul class="grid gap-3">
                    <% if (fs.contact_email) { %><li><a href="mailto:<%= fs.contact_email %>" class="footer-link break-all"><i class="fas fa-envelope w-5 text-cyan-300/80"></i> <%= fs.contact_email %></a></li><% } %>
                    <% if (fs.whatsapp_url) { %><li><a href="<%= fs.whatsapp_url %>" target="_blank" rel="noopener" class="footer-link"><i class="fab fa-whatsapp w-5 text-cyan-300/80"></i> WhatsApp updates</a></li><% } %>
                    <li><span class="footer-link cursor-default"><i class="fas fa-location-dot w-5 text-cyan-300/80"></i> Sinai University</span></li>
                </ul>
            </div>
        </div>

        <div class="mt-14 pt-6 border-t border-white/10 flex flex-col-reverse md:flex-row items-center justify-between gap-5 text-sm">
            <p class="text-slate-500 text-center md:text-left">&copy; <%= new Date().getFullYear() %> Sinai University ACM Student Chapter. All rights reserved.</p>
            <a href="https://github.com/Mo1Amin" target="_blank" rel="noopener author" class="dev-credit" data-click="footer-developer">
                <span class="dev-credit-mark" aria-hidden="true">&lt;/&gt;</span>
                <span>Designed &amp; developed by <strong class="whitespace-nowrap">Eng. Mohamed Amin</strong></span>
                <i class="fab fa-github" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</footer>

<div id="lightbox" class="lb-hidden fixed inset-0 z-[80] bg-slate-950 flex flex-col" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <div class="flex items-center justify-between px-4 md:px-8 py-4 text-white">
        <div class="min-w-0"><div id="lb-title" class="font-bold text-lg md:text-xl truncate"></div><div id="lb-counter" class="text-sm text-slate-400"></div></div>
        <button type="button" id="lb-close" aria-label="Close" class="w-12 h-12 shrink-0 grid place-items-center rounded-full hover:bg-white/10 text-2xl"><i class="fas fa-xmark"></i></button>
    </div>
    <div id="lb-stage" class="relative flex-1 flex items-center justify-center px-2 md:px-20 min-h-0">
        <button type="button" id="lb-prev" aria-label="Previous photo" class="absolute left-2 md:left-6 w-12 h-12 grid place-items-center rounded-full bg-white/10 hover:bg-white/20 text-white text-xl z-10"><i class="fas fa-chevron-left"></i></button>
        <img id="lb-image" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" class="max-h-full max-w-full object-contain rounded-xl select-none">
        <button type="button" id="lb-next" aria-label="Next photo" class="absolute right-2 md:right-6 w-12 h-12 grid place-items-center rounded-full bg-white/10 hover:bg-white/20 text-white text-xl z-10"><i class="fas fa-chevron-right"></i></button>
    </div>
    <div id="lb-caption" class="text-center text-slate-300 px-6 pt-3 min-h-[1.5rem]"></div>
    <div id="lb-thumbs" class="flex gap-2 overflow-x-auto no-scrollbar px-4 py-4 justify-start md:justify-center"></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js" defer></script>
<script src="/assets/js/site.js?v=<%= version %>" defer></script>
</body>
</html>
