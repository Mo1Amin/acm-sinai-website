<%- include('partials/header') %>
<% const st = trackStatus(track.status); %>
<main class="pt-28 pb-10" data-section="track:<%= track.slug %>">
    <div class="container mx-auto px-6 max-w-5xl">
        <a href="/#tracks" class="inline-flex items-center gap-2 text-ink-muted hover:text-brand font-semibold py-2"><i class="fas fa-arrow-left"></i> All tracks</a>

        <div class="glass-card rounded-[2.5rem] p-7 md:p-12 mt-4 flex flex-col md:flex-row gap-8 md:items-center">
            <div class="icon-tile w-24 h-24 md:w-32 md:h-32 text-4xl md:text-6xl shrink-0"><i class="fas <%= track.icon %>"></i></div>
            <div class="flex-1">
                <span class="status-badge status-<%= st.key %>"><span class="dot"></span><%= st.label %></span>
                <h1 class="text-4xl md:text-6xl font-black text-ink mt-3"><%= track.name %></h1>
                <p class="mt-4 text-lg md:text-xl text-ink-soft leading-relaxed"><%= track.description || track.short_desc %></p>
            </div>
        </div>

        <div class="grid md:grid-cols-5 gap-6 mt-6">
            <div class="md:col-span-3 flex flex-col gap-6">
                <% if (skills.length) { %>
                <section class="glass-card rounded-3xl p-7 md:p-9">
                    <h2 class="text-2xl font-black text-ink mb-5">What you will learn</h2>
                    <ul class="grid sm:grid-cols-2 gap-3">
                        <% skills.forEach((sk, i) => { %>
                            <li class="flex items-center gap-3 rounded-2xl bg-surface-2 px-4 py-3 font-semibold text-ink"><span class="num-badge"><%= i + 1 %></span><%= sk %></li>
                        <% }) %>
                    </ul>
                </section>
                <% } %>
                <% if (roadmap.length) { %>
                <section class="glass-card rounded-3xl p-7 md:p-9">
                    <h2 class="text-2xl font-black text-ink mb-6">Roadmap</h2>
                    <ol class="roadmap">
                        <% roadmap.forEach((step, i) => { %>
                            <li><span class="step"><%= i + 1 %></span><span class="font-semibold text-ink"><%= step %></span></li>
                        <% }) %>
                    </ol>
                </section>
                <% } %>
            </div>
            <aside class="md:col-span-2 flex flex-col gap-6">
                <% if (track.mentor_name) { %>
                <section class="glass-card rounded-3xl p-7 text-center">
                    <p class="section-kicker">Mentor</p>
                    <% if (track.mentor_photo) { %>
                        <img src="<%= asset(track.mentor_photo) %>" alt="<%= track.mentor_name %>" class="w-28 h-28 rounded-full object-cover mx-auto mt-3 avatar-ring p-1">
                    <% } else { %>
                        <div class="w-28 h-28 rounded-full mx-auto mt-3 grid place-items-center avatar-initials text-3xl font-black"><%= initials(track.mentor_name) %></div>
                    <% } %>
                    <h3 class="text-xl font-bold text-ink mt-4"><%= track.mentor_name %></h3>
                    <p class="text-ink-muted"><%= track.mentor_title %></p>
                </section>
                <% } %>
                <section class="join-panel rounded-3xl p-7 text-center">
                    <h3 class="text-2xl font-black text-white">Join this track</h3>
                    <% if (track.status === 'open' && track.join_url) { %>
                        <p class="text-slate-200 mt-2">Registration is open now.</p>
                        <a href="<%= track.join_url %>" target="_blank" rel="noopener" data-click="track-join:<%= track.slug %>" class="btn-light mt-5">Join now</a>
                    <% } else if (track.status === 'closed') { %>
                        <p class="text-slate-200 mt-2">Registration for this track is closed. Follow our pages for the next round.</p>
                    <% } else { %>
                        <p class="text-slate-200 mt-2">Registration opens soon. Follow our pages so you don't miss it.</p>
                    <% } %>
                </section>
            </aside>
        </div>

        <% if (others.length) { %>
        <section class="mt-16">
            <h2 class="text-2xl font-black text-ink mb-6">Other tracks</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <% others.slice(0, 8).forEach((t) => { %>
                    <a href="/tracks/<%= t.slug %>" data-click="track:<%= t.slug %>" class="glass-card card-hover rounded-2xl p-5 flex items-center gap-3">
                        <div class="icon-tile w-11 h-11 text-lg shrink-0"><i class="fas <%= t.icon %>"></i></div>
                        <span class="font-bold text-ink leading-tight"><%= t.name %></span>
                    </a>
                <% }) %>
            </div>
        </section>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>
