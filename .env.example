# Copy to .env on the server (never commit .env).

NODE_ENV=production

# Public URL of the site, no trailing slash
BASE_URL=https://su.acm.org

# MariaDB / MySQL (create in cPanel > Manage My Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=suhosting_acm
DB_USER=suhosting_acm
DB_PASS=change-me

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
ANALYTICS_SALT=change-me

# Optional: where uploaded images are stored (defaults to public/uploads)
# UPLOADS_DIR=/home/suhosting/acm-uploads
